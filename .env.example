# Gemini API Key
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Gemini 안정성 전략 (모델 폴백 + 장기 재시도)
GEMINI_MODELS="gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash"
GEMINI_MODEL_ATTEMPTS_PER_MODEL=3
GEMINI_RETRY_INTERVAL_SECONDS=300
GEMINI_HTTP_RETRY_ATTEMPTS=2

# Email settings for sending the summary
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="YOUR_EMAIL@gmail.com"
SMTP_PASSWORD="YOUR_APP_PASSWORD"

# Sender email address (used in the 'From' header of the email)
MAIL_FROM="sender@example.com"

# Recipient email address
MAIL_TO="recipient@example.com"
