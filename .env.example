# Google Gemini API Key
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Gemini 모델 설정 및 안정성 전략
# "auto" 또는 "dynamic" 지정 시, google-genai SDK를 통해 가용 가능한 최신 모델을 동적 수집하고 헬스체크를 진행합니다.
# 직접 선호 모델 리스트를 콤마(,)로 구분하여 지정할 수도 있으며, 지정된 모델 실패 시 동적 Fallback이 수행됩니다.
GEMINI_MODELS="auto"
# GEMINI_MODELS="gemini-3.5-flash,gemini-2.5-flash"

# 모델 재시도 및 폴백 백오프 설정
GEMINI_MODEL_ATTEMPTS_PER_MODEL=3
GEMINI_RETRY_INTERVAL_SECONDS=300
GEMINI_HTTP_RETRY_ATTEMPTS=2

# SMTP 이메일 발송 설정
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="YOUR_EMAIL@gmail.com"
SMTP_PASSWORD="YOUR_APP_PASSWORD"

# 발신자 및 수신자 이메일 주소
MAIL_FROM="sender@example.com"
MAIL_TO="recipient@example.com"
